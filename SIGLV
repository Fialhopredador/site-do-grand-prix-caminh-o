  icon: React.ReactNode;
  label: string;
  value: number | string;
  danger?: boolean;
}) {
  return (
    <div className={`metric ${danger ? "danger" : ""}`}>
      <div className="metric-icon">{icon}</div>

      <div>
        <strong>{value}</strong>
        <span>{label}</span>
      </div>
    </div>
  );
}

function TabelaCaminhoes({
  caminhoes
}: {
  caminhoes: Caminhao[];
}) {
  return (
    <div className="table-container">
      <table>
        <thead>
          <tr>
            <th>Placa</th>
            <th>Transportadora</th>
            <th>Operação</th>
            <th>Carga</th>
            <th>Etapa</th>
            <th>Doca</th>
            <th>Horário</th>
            <th>Status</th>
          </tr>
        </thead>

        <tbody>
          {caminhoes.map((c) => {
            const minutos = minutosDesde(c.inicioEtapa);

            let nivel = "normal";

            if (
              (c.status === "PATIO" && minutos > 15) ||
              (c.status === "PESAGEM" && minutos > 10)
            ) {
              nivel = "atraso";
            }

            if (
              c.status === "OPERACAO" &&
              minutos >
                (c.operacao === "Carga" ? 30 : 35)
            ) {
              nivel = "critico";
            }

            return (
              <tr key={c.id}>
                <td>
                  <strong>{c.placa}</strong>
                </td>
                <td>{c.transportadora}</td>
                <td>{c.operacao}</td>
                <td>{c.carga}</td>
                <td>{c.status}</td>
                <td>{c.doca ? `Doca ${c.doca}` : "—"}</td>
                <td>{c.entrada || c.horario}</td>
                <td>
                  <span className={`status ${nivel}`}>
                    {nivel}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}

