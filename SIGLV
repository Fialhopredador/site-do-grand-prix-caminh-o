import { FormEvent, useEffect, useMemo, useState } from "react";

type Tela =
  | "dashboard"
  | "agendamentos"
  | "portaria"
  | "operacao"
  | "docas"
  | "alertas"
  | "simulacao";

type Status =
  | "AGENDADO"
  | "PORTARIA"
  | "PESAGEM"
  | "PATIO"
  | "DOCA"
  | "OPERACAO"
  | "CONFERENCIA"
  | "LIBERADO"
  | "FINALIZADO";

type Caminhao = {
  id: number;
  placa: string;
  motorista: string;
  transportadora: string;
  veiculo: string;
  carga: string;
  peso: number;
  quantidade: number;
  operacao: "Carga" | "Descarga";
  data: string;
  horario: string;
  status: Status;
  doca?: number;
  entrada?: string;
  inicioEtapa?: number;
};

type Doca = {
  id: number;
  nome: string;
  caminhaoId?: number;
  reservada?: boolean;
};

