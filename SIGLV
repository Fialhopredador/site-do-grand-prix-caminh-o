  aberto: boolean;
  fechar: () => void;
}) {
  const itens = [
    ["dashboard", LayoutDashboard, "Dashboard"],
    ["agendamentos", CalendarDays, "Agendamentos"],
    ["portaria", LogIn, "Portaria"],
    ["operacao", Truck, "Operação"],
    ["docas", Warehouse, "Docas"],
    ["alertas", Bell, "Alertas"],
    ["simulacao", Gauge, "Simulação"]
  ] as const;

  return (
    <>
      {aberto && <div className="overlay" onClick={fechar} />}

      <aside className={`sidebar ${aberto ? "open" : ""}`}>
        <div className="brand">
          <div className="brand-icon">
            <Truck />
          </div>

          <div>
            <strong>SIGLV</strong>
            <small>Controle Logístico</small>
          </div>

          <button className="close-menu" onClick={fechar}>
            <X size={18} />
          </button>
        </div>

        <nav>
          {itens.map(([id, Icon, label]) => (
            <button
              key={id}
