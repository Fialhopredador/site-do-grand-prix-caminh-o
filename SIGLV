function NovoAgendamento({
  fechar,
  salvar,
  caminhoes
}: {
  fechar: () => void;
  salvar: (c: Omit<Caminhao, "id" | "status">) => void;
  caminhoes: Caminhao[];
}) {
  const [horario, setHorario] = useState("08:00");
  const [aviso, setAviso] = useState("");

  function validarHorario(valor: string) {
    setHorario(valor);

    const quantidade = caminhoes.filter(
      (c) => c.horario === valor
    ).length;

    if (quantidade >= 3) {
      setAviso(
        "Alta ocupação prevista. Considere selecionar outro horário."
      );
    } else {
      setAviso("");
    }
  }

  function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    const data = new FormData(event.currentTarget);

    salvar({
      placa: String(data.get("placa")).toUpperCase(),
      motorista: String(data.get("motorista")),
      transportadora: String(data.get("transportadora")),
      veiculo: String(data.get("veiculo")),
      carga: String(data.get("carga")),
      peso: Number(data.get("peso")),
      quantidade: Number(data.get("quantidade")),
      operacao: String(data.get("operacao")) as
        | "Carga"
        | "Descarga",
      data: String(data.get("data")),
      horario
    });
  }

  return (
    <div className="modal-backdrop">
      <form className="modal" onSubmit={submit}>
        <div className="modal-header">
          <div>
            <h2>Novo agendamento</h2>
            <p>
              Cadastre a operação antes da chegada do
              veículo.
            </p>
          </div>

          <button type="button" onClick={fechar}>
            <X />
          </button>
        </div>

        <div className="form-grid">
          <label>
            Placa
            <input name="placa" required placeholder="ABC1D23" />
          </label>

          <label>
            Motorista
            <input
              name="motorista"
              required
              placeholder="Nome do motorista"
            />
          </label>

          <label>
            Transportadora
            <input
              name="transportadora"
              required
              placeholder="Transportadora"
            />
          </label>

          <label>
            Tipo de veículo
            <select name="veiculo">
              <option>VUC</option>
              <option>Toco</option>
              <option>Truck</option>
              <option>Carreta</option>
              <option>Bitrem</option>
              <option>Rodotrem</option>
            </select>
          </label>

          <label>
            Operação
            <select name="operacao">
              <option>Carga</option>
              <option>Descarga</option>
            </select>
          </label>

          <label>
            Tipo de carga
            <input
              name="carga"
              placeholder="Matéria-prima"
              required
            />
          </label>

          <label>
            Peso estimado (kg)
            <input
              name="peso"
              type="number"
              defaultValue={20000}
            />
          </label>

          <label>
            Quantidade
            <input
              name="quantidade"
              type="number"
              defaultValue={20}
            />
          </label>

          <label>
            Data
            <input name="data" type="date" required />
          </label>

          <label>
            Horário
            <input
              name="horario"
              type="time"
              value={horario}
              onChange={(e) =>
                validarHorario(e.target.value)
              }
              required
            />
          </label>
        </div>

        {aviso && (
          <div className="warning-box">
            <AlertTriangle size={18} />
            {aviso}
          </div>
        )}

        <div className="modal-actions">
          <button
            type="button"
            className="secondary"
            onClick={fechar}
          >
            Cancelar
          </button>

          <button className="primary">
            Confirmar agendamento
          </button>
        </div>
      </form>
    </div>
  );
}

function Portaria({
  caminhoes,
  liberar
}: {
  caminhoes: Caminhao[];
  liberar: (c: Caminhao) => void;
}) {
  const [busca, setBusca] = useState("");

  const encontrados = caminhoes.filter((c) =>
    c.placa.toLowerCase().includes(busca.toLowerCase())
  );

  return (
    <>
      <div className="page-heading">
        <div>
          <h2>Portaria</h2>
          <p>
            Identificação e liberação de veículos.
          </p>
        </div>
      </div>

      <div className="panel">
        <input
          className="search"
          placeholder="Digite a placa do caminhão..."
          value={busca}
          onChange={(e) => setBusca(e.target.value)}
        />

        <div className="vehicle-cards">
          {encontrados.map((c) => (
            <div className="vehicle-card" key={c.id}>
              <div>
                <span className="plate">{c.placa}</span>
                <h3>{c.transportadora}</h3>
                <p>
                  {c.motorista} • {c.veiculo}
                </p>
                <p>
                  {c.operacao} • {c.carga}
                </p>
              </div>

              {c.status === "AGENDADO" ? (
                <button
                  className="primary"
                  onClick={() => liberar(c)}
                >
                  <CheckCircle2 size={17} />
                  Liberar entrada
                </button>
              ) : (
                <span className="approved">
                  <CheckCircle2 size={17} />
                  Entrada registrada
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    </>
  );
}

function Operacao({
  caminhoes,
  proxima,
  enviarParaDoca,
  liberarDoca
}: {
  caminhoes: Caminhao[];
  proxima: (c: Caminhao) => void;
  enviarParaDoca: (c: Caminhao) => void;
  liberarDoca: (c: Caminhao) => void;
}) {
  return (
    <>
      <div className="page-heading">
        <div>
          <h2>Operação</h2>
          <p>
            Coordenação do caminhão desde a entrada até a
            saída.
          </p>
        </div>
      </div>

      <div className="operation-grid">
        {caminhoes
          .filter((c) => c.status !== "AGENDADO")
          .map((c) => (
            <div className="operation-card" key={c.id}>
              <div className="operation-top">
                <div>
                  <span className="plate">{c.placa}</span>
                  <h3>{c.status}</h3>
                </div>

                <div className="timer">
                  <Clock3 size={17} />
                  {minutosDesde(c.inicioEtapa)} min
                </div>
              </div>

              <p>
                {c.transportadora} • {c.operacao}
              </p>

              <p>{c.carga}</p>

              {c.doca && (
                <strong>Doca {c.doca}</strong>
              )}

              <div className="timeline">
                {[
                  "PORTARIA",
                  "PESAGEM",
                  "PATIO",
                  "DOCA",
                  "OPERACAO",
                  "CONFERENCIA",
                  "LIBERADO",
                  "FINALIZADO"
                ].map((etapa) => (
                  <span
                    key={etapa}
                    className={
                      etapa === c.status ? "current" : ""
                    }
                  >
                    {etapa}
                  </span>
                ))}
              </div>

              <div className="card-actions">
                {c.status === "PATIO" && (
                  <button
                    className="primary"
                    onClick={() => enviarParaDoca(c)}
                  >
                    Enviar para doca
                  </button>
                )}

                {c.status === "DOCA" && (
                  <button
                    className="primary"
                    onClick={() =>
                      proxima({
                        ...c,
                        status: "DOCA"
                      })
                    }
                  >
                    Iniciar operação
                  </button>
                )}

                {c.status === "OPERACAO" && (
                  <button
                    className="primary"
                    onClick={() => liberarDoca(c)}
                  >
                    Finalizar operação
                  </button>
                )}

                {![
                  "PATIO",
                  "DOCA",
                  "OPERACAO",
                  "FINALIZADO"
                ].includes(c.status) && (
                  <button
                    className="primary"
                    onClick={() => proxima(c)}
                  >
                    Concluir etapa
                  </button>
                )}
              </div>
            </div>
          ))}
      </div>
    </>
  );
}

function Docas({
  docas,
  caminhoes
}: {
  docas: Doca[];
  caminhoes: Caminhao[];
}) {
  return (
    <>
      <div className="page-heading">
        <div>
          <h2>Gestão de Docas</h2>
          <p>
            Visualize rapidamente a capacidade de
            carregamento e descarga.
          </p>
        </div>
      </div>

      <div className="dock-grid">
        {docas.map((d) => {
          const c = caminhoes.find(
            (v) => v.id === d.caminhaoId
          );

          return (
            <div
              className={`dock ${c ? "busy" : "free"}`}
              key={d.id}
            >
              <div className="dock-header">
                <Warehouse />
                <strong>{d.nome}</strong>
              </div>

              {!c ? (
                <>
                  <span className="status normal">Livre</span>
                  <p>Aguardando próximo veículo.</p>
                </>
              ) : (
                <>
                  <span className="status atraso">
                    Ocupada
                  </span>

                  <h3>{c.placa}</h3>
                  <p>{c.operacao}</p>
                  <p>{c.carga}</p>

                  <div className="timer">
                    <Clock3 size={16} />
                    {minutosDesde(c.inicioEtapa)} min
                  </div>
                </>
              )}
            </div>
          );
        })}
      </div>
    </>
  );
}

function Alertas({
  caminhoes,
  tick
}: {
  caminhoes: Caminhao[];
  tick: number;
}) {
  const alertas = caminhoes
    .map((c) => {
      const minutos = minutosDesde(c.inicioEtapa);

      if (c.status === "PATIO" && minutos >= 12) {
        return {
          c,
          nivel: minutos > 15 ? "atraso" : "atencao",
          mensagem:
            minutos > 15
              ? `Veículo aguardando doca há ${minutos} minutos.`
              : `Veículo próximo do limite de espera no pátio.`
        };
      }

      if (
        c.status === "OPERACAO" &&
        minutos >=
          (c.operacao === "Carga" ? 25 : 30)
      ) {
        const limite =
          c.operacao === "Carga" ? 30 : 35;

        return {
          c,
          nivel:
            minutos > limite ? "critico" : "atencao",
          mensagem:
            minutos > limite
              ? `${c.operacao} excedeu o tempo previsto em ${
                  minutos - limite
                } minutos.`
              : `${c.operacao} próxima do tempo limite.`
        };
      }

      return null;
    })
    .filter(Boolean) as any[];

  return (
    <>
      <div className="page-heading">
        <div>
          <h2>Central de Alertas</h2>
          <p>
            Identificação preventiva de atrasos e
            gargalos.
          </p>
        </div>
      </div>

      {alertas.length === 0 ? (
        <div className="empty">
          <CheckCircle2 size={40} />
          <h3>Operação dentro dos limites</h3>
          <p>Nenhum alerta operacional no momento.</p>
        </div>
      ) : (
        <div className="alerts">
          {alertas.map(({ c, nivel, mensagem }) => (
            <div className={`alert ${nivel}`} key={c.id}>
              <AlertTriangle />

              <div>
                <strong>
                  {nivel === "critico"
                    ? "Gargalo crítico"
                    : nivel === "atraso"
                    ? "Atraso identificado"
                    : "Atenção operacional"}
                </strong>

                <p>{mensagem}</p>

                <small>
                  {c.placa} • {c.transportadora} •{" "}
                  {c.status}
                </small>
              </div>
            </div>
          ))}
        </div>
      )}
    </>
  );
}

function SimulacaoPlaceholder() {
