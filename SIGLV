  id: index + 1,
  nome: `Doca ${String(index + 1).padStart(2, "0")}`
}));

function minutosDesde(timestamp?: number) {
  if (!timestamp) return 0;
  return Math.max(0, Math.floor((Date.now() - timestamp) / 60000));
}

export default function Home() {
  const [tela, setTela] = useState<Tela>("dashboard");
  const [menuMobile, setMenuMobile] = useState(false);

  const [caminhoes, setCaminhoes] =
    useState<Caminhao[]>(DEMO_CAMINHOES);

  const [docas, setDocas] = useState<Doca[]>(() => {
    const base = [...DEMO_DOCAS];

    base[2] = {
      ...base[2],
      caminhaoId: 1
    };

    return base;
  });

  const [modalAgendamento, setModalAgendamento] = useState(false);

  const [tick, setTick] = useState(0);

  useEffect(() => {
    const saved = localStorage.getItem("siglv-caminhoes");

    if (saved) {
      try {
        setCaminhoes(JSON.parse(saved));
      } catch {}
    }
  }, []);

  useEffect(() => {
    localStorage.setItem(
      "siglv-caminhoes",
      JSON.stringify(caminhoes)
    );
  }, [caminhoes]);

  useEffect(() => {
    const interval = setInterval(() => {
      setTick((v) => v + 1);
    }, 30000);

    return () => clearInterval(interval);
  }, []);

  const metricas = useMemo(() => {
    const presentes = caminhoes.filter(
      (c) =>
        c.status !== "AGENDADO" &&
        c.status !== "FINALIZADO"
    );

    const aguardando = caminhoes.filter(
      (c) =>
        c.status === "PATIO" ||
        c.status === "PORTARIA"
    );

    const operacao = caminhoes.filter(
      (c) =>
        c.status === "OPERACAO" ||
        c.status === "DOCA"
    );

    const atrasados = caminhoes.filter((c) => {
      const minutos = minutosDesde(c.inicioEtapa);

      if (c.status === "PATIO") return minutos > 15;
      if (c.status === "PESAGEM") return minutos > 10;
      if (c.status === "OPERACAO") {
        return minutos > (c.operacao === "Carga" ? 30 : 35);
      }

      return false;
    });

    const docasOcupadas =
      docas.filter((d) => d.caminhaoId).length;

    return {
      previstos: caminhoes.length,
      presentes: presentes.length,
      aguardando: aguardando.length,
      operacao: operacao.length,
      atrasados: atrasados.length,
      docasOcupadas
    };
  }, [caminhoes, docas, tick]);

  function atualizarCaminhao(
    id: number,
    patch: Partial<Caminhao>
  ) {
    setCaminhoes((atual) =>
      atual.map((c) =>
        c.id === id ? { ...c, ...patch } : c
      )
    );
  }

  function proximaEtapa(c: Caminhao) {
    const fluxo: Status[] = [
      "AGENDADO",
      "PORTARIA",
      "PESAGEM",
      "PATIO",
      "DOCA",
      "OPERACAO",
      "CONFERENCIA",
      "LIBERADO",
      "FINALIZADO"
    ];

    const index = fluxo.indexOf(c.status);

    if (index === fluxo.length - 1) return;

    const nova = fluxo[index + 1];

    atualizarCaminhao(c.id, {
      status: nova,
      inicioEtapa: Date.now()
    });
  }

  function liberarEntrada(c: Caminhao) {
    atualizarCaminhao(c.id, {
      status: "PORTARIA",
      entrada: new Date().toLocaleTimeString("pt-BR", {
        hour: "2-digit",
        minute: "2-digit"
      }),
      inicioEtapa: Date.now()
    });
  }

  function enviarParaDoca(c: Caminhao) {
    const livre = docas.find((d) => !d.caminhaoId);

    if (!livre) {
      alert("Nenhuma doca disponível.");
      return;
    }

    setDocas((atual) =>
      atual.map((d) =>
        d.id === livre.id
          ? { ...d, caminhaoId: c.id }
          : d
      )
    );

    atualizarCaminhao(c.id, {
      doca: livre.id,
      status: "DOCA",
      inicioEtapa: Date.now()
    });
  }

  function liberarDoca(c: Caminhao) {
    setDocas((atual) =>
      atual.map((d) =>
        d.caminhaoId === c.id
          ? { ...d, caminhaoId: undefined }
          : d
      )
    );

    atualizarCaminhao(c.id, {
      doca: undefined,
      status: "CONFERENCIA",
      inicioEtapa: Date.now()
    });
  }

  return (
    <div className="app">
      <Sidebar
        tela={tela}
        setTela={setTela}
        aberto={menuMobile}
        fechar={() => setMenuMobile(false)}
      />

      <main className="main">
        <header className="topbar">
          <button
            className="mobile-menu"
            onClick={() => setMenuMobile(true)}
          >
            <Menu size={22} />
          </button>

          <div>
            <h1>SIGLV</h1>
            <p>
              Sistema Integrado de Gestão e Liberação de
              Veículos
            </p>
          </div>

          <div className="demo-badge">
            <Factory size={16} />
            Ambiente demonstrativo
          </div>
        </header>

        <section className="content">
          {tela === "dashboard" && (
            <Dashboard
              caminhoes={caminhoes}
              metricas={metricas}
              onNovo={() => setModalAgendamento(true)}
            />
          )}

          {tela === "agendamentos" && (
            <Agendamentos
              caminhoes={caminhoes}
              onNovo={() => setModalAgendamento(true)}
            />
          )}

          {tela === "portaria" && (
            <Portaria
              caminhoes={caminhoes}
              liberar={liberarEntrada}
            />
          )}

          {tela === "operacao" && (
            <Operacao
              caminhoes={caminhoes}
              proxima={proximaEtapa}
              enviarParaDoca={enviarParaDoca}
              liberarDoca={liberarDoca}
            />
          )}

          {tela === "docas" && (
            <Docas
              docas={docas}
              caminhoes={caminhoes}
            />
          )}

          {tela === "alertas" && (
            <Alertas caminhoes={caminhoes} tick={tick} />
          )}

          {tela === "simulacao" && <SimulacaoPlaceholder />}
        </section>
      </main>

      {modalAgendamento && (
        <NovoAgendamento
          fechar={() => setModalAgendamento(false)}
          salvar={(novo) => {
            setCaminhoes((atual) => [
              ...atual,
              {
                ...novo,
                id: Date.now(),
                status: "AGENDADO"
              }
            ]);

            setModalAgendamento(false);
          }}
          caminhoes={caminhoes}
        />
      )}
    </div>
  );
}

