                setTela(id);
                fechar();
              }}
            >
              <Icon size={19} />
              {label}
            </button>
          ))}
        </nav>

        <div className="sidebar-footer">
          <Settings size={18} />
          Configurações
        </div>
      </aside>
    </>
  );
}

